# Base de datos (Neon — Postgres serverless)
# Usa la cadena de conexión "pooled" del proyecto/branch de Neon.
DATABASE_URL=

# better-auth
# Genera el secreto con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# OAuth — Google Cloud Console
# Callback autorizado: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Facebook (Meta for Developers)
# Callback autorizado: {BETTER_AUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
